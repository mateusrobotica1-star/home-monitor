# ========================================
# CONFIGURAÇÕES DO BACKEND
# Copie este arquivo como .env e preencha!
# ========================================

# URL do Supabase (encontra no painel do Supabase > Settings > API)
# Exemplo: https://xxxxx.supabase.co
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave de serviço (service_role) - NUNCA compartilhe publicamente!
# Painel Supabase > Settings > API > service_role secret
SUPABASE_SERVICE_KEY=sua_chave_de_servico_aqui

# Chave secreta do ESP32 (use a MESMA no código .ino)
API_KEY=sua_chave_secreta_aqui

# Porta (a Render define automaticamente) - não altere na maioria dos casos
PORT=3000
